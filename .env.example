# Long random string used to sign login cookies. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The first super admin, created automatically when the database is empty.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change-me-please

# Where the SQLite database file lives (default: ./data/feedback.db)
# DATABASE_PATH=./data/feedback.db
