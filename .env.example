# Long random string used to sign login cookies. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The TeamDesk API people sign in against. Accounts, passwords and admin rights all live there.
TEAMDESK_API_URL=https://35-200-237-138.nip.io

# Shared with TeamDesk's desktop_apps row for this app. TeamDesk's admin page sends it as ?key=, and
# the /api/teamdesk routes answer only when it matches. Generate with: openssl rand -hex 24
TEAMDESK_APP_KEY=

# Where the SQLite database file lives (default: ./data/feedback.db)
# DATABASE_PATH=./data/feedback.db
